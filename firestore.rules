rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Server-only data: pushDevices stores notification tokens and their owners;
    // collectionPushJobs stores delivery jobs, leases and deduplication state.
    // Only the backend Admin SDK may access either top-level collection or its
    // descendants. Client claims and document fields never grant access here.
    // Exclude these paths from the legacy allow itself: an overlapping deny rule
    // would not override a matching allow in Firestore.
    match /{collection}/{document=**} {
      // CRITICAL existing limitation: all other collections remain publicly
      // readable/writable until this date. This scoped protection does not make
      // the wider database secure. See docs/security/collection-push-rules.md.
      allow read, write: if collection != 'pushDevices'
                         && collection != 'collectionPushJobs'
                         && request.time < timestamp.date(2030, 12, 31);
    }
  }
}
